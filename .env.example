# Heavenly ID deployment environment example
# Copy to your server environment manager. Do NOT commit real values.

# Database connection lives in protected/pdo.php on production.
# protected/pdo.php is intentionally gitignored.

# Mail / contact form
HEAVENLY_SMTP_HOST=localhost
HEAVENLY_SMTP_PORT=25
HEAVENLY_SMTP_USER=
HEAVENLY_SMTP_PASS=
HEAVENLY_SMTP_SECURE=
HEAVENLY_MAIL_FROM=info@heavenlyid.com
HEAVENLY_CONTACT_TO=info@heavenlyid.com

# Printer/status emails
HID_MAIL_FROM=info@heavenlyid.com
HID_PRINTER_EMAIL_TO=info@threadkraze.com,info@heavenlyid.com
HID_PRINTER_STATUS_TO=info@threadkraze.com

# Shopify Storefront checkout
HID_SHOPIFY_DOMAIN=
HID_SHOPIFY_STOREFRONT_TOKEN=
HID_SHOPIFY_API_VERSION=2026-01
HID_SHOPIFY_PRODUCT_ID=

# Shopify paid webhook validation should be implemented in shopify_paid_webhook.php
# and configured with server-side secrets only.
